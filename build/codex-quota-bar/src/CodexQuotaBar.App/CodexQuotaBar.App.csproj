<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CodexQuotaBar</AssemblyName>
    <RootNamespace>CodexQuotaBar.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Codex Quota Bar</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexQuotaBar.Core\CodexQuotaBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"
                      Exclude="Assets\Pets\suit-hamster.gif" />
    <EmbeddedResource Include="Assets\Pets\suit-hamster.gif"
                      LogicalName="CodexQuotaBar.Assets.Pets.suit-hamster.gif" />
  </ItemGroup>
</Project>
