<UserControl x:Class="CodexThreadWorkbench.Views.ThreadCardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Margin="7"
          Background="{StaticResource CardBackgroundBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          BoxShadow="0 3 13 0 #14344047">
    <Grid RowDefinitions="45,*">
      <Border Grid.Row="0"
              Padding="11,0"
              Background="#F3F6F6"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Grid.Column="0"
                   Width="7"
                   Height="7"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Fill="{Binding StatusColor, Converter={StaticResource StatusColorToBrushConverter}}" />
          <StackPanel Grid.Column="1"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Binding WorkingDirectory}">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       Text="{Binding WorkingDirectory}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <Border Margin="6,0,5,0"
                    Padding="7,3"
                    Background="#EAF0ED"
                    CornerRadius="8">
              <TextBlock x:Name="StatusLabel"
                         Foreground="{Binding StatusColor, Converter={StaticResource StatusColorToBrushConverter}}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Text="{Binding StatusText}" />
            </Border>
            <Button Classes="icon"
                    Command="{Binding StopCommand}"
                    Content="■"
                    IsVisible="{Binding IsRunning}"
                    ToolTip.Tip="停止当前回合" />
            <Button Classes="icon"
                    Command="{Binding ToggleMinimizeCommand}"
                    Content="{Binding MinimizeGlyph}"
                    ToolTip.Tip="最小化此对话" />
            <Button Classes="icon"
                    Command="{Binding CloseCommand}"
                    Content="×"
                    ToolTip.Tip="从工作台关闭" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            RowDefinitions="Auto,Auto,*,Auto"
            IsVisible="{Binding !IsMinimized}">
        <Border Grid.Row="0"
                Margin="9,9,9,0"
                Padding="10,8"
                Background="#FFF4E6"
                BorderBrush="#F1D4A9"
                BorderThickness="1"
                CornerRadius="7"
                IsVisible="{Binding HasPendingApproval}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Foreground="#8A571D"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="Codex 需要你的确认" />
              <TextBlock Margin="0,3,10,0"
                         Foreground="#9A682F"
                         FontSize="10"
                         Text="{Binding PendingApproval.Description}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
              <Button Classes="toolbar"
                      Command="{Binding DeclineCommand}"
                      Content="拒绝" />
              <Button Classes="primary"
                      Command="{Binding ApproveCommand}"
                      Content="允许本次" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="9,7,9,0"
                Padding="9,6"
                Background="#FDEDED"
                BorderBrush="#EFCACA"
                BorderThickness="1"
                CornerRadius="7"
                IsVisible="{Binding HasError}">
          <TextBlock Foreground="#A23D3D"
                     FontSize="10"
                     Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap" />
        </Border>

        <ListBox x:Name="MessagesList"
                 Grid.Row="2"
                 Margin="8,7,8,4"
                 Padding="2"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,5" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border MaxWidth="560"
                      Padding="10,7"
                      HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}"
                      Background="{Binding Role, Converter={StaticResource ChatRoleToBrushConverter}}"
                      CornerRadius="8">
                <TextBlock FontSize="12"
                           LineHeight="18"
                           Text="{Binding Text}"
                           TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Padding="8"
                Background="#F4F6F7"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="MessageInput"
                     Classes="input"
                     MinHeight="38"
                     MaxHeight="92"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="True"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     KeyDown="MessageInput_OnKeyDown"
                     ToolTip.Tip="Enter 发送，Shift+Enter 换行" />
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Classes="primary"
                    Width="38"
                    Height="38"
                    Margin="7,0,0,0"
                    Padding="0"
                    Command="{Binding SendCommand}"
                    Content="↑"
                    FontSize="16"
                    ToolTip.Tip="发送" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="10"
              Padding="11,8"
              VerticalAlignment="Top"
              Background="#F4F6F7"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="7"
              IsVisible="{Binding IsMinimized}">
        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="11"
                   Text="此对话已最小化；点击标题栏的 □ 恢复。" />
      </Border>
    </Grid>
  </Border>
</UserControl>
