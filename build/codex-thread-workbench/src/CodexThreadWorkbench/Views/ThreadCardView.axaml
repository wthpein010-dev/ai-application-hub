<UserControl x:Class="CodexThreadWorkbench.Views.ThreadCardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragDrop.DragEnter="ThreadCard_OnDragEnter"
             DragDrop.DragLeave="ThreadCard_OnDragLeave"
             DragDrop.DragOver="ThreadCard_OnDragOver"
             DragDrop.Drop="ThreadCard_OnDrop">
  <UserControl.Styles>
    <Style Selector="Border#CardShell.dragging">
      <Setter Property="Opacity" Value="0.68" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Border#CardShell.drop-target">
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #334CAF71" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="CardShell"
          Margin="7"
          Background="{StaticResource CardBackgroundBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          BoxShadow="0 3 13 0 #14344047">
    <Grid RowDefinitions="45,*">
      <Border Grid.Row="0"
              x:Name="DragSurface"
              Padding="11,0"
              Background="#F3F6F6"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0"
              Cursor="SizeAll"
              ToolTip.Tip="拖动卡片到另一个会话以交换位置"
              PointerPressed="DragSurface_OnPointerPressed"
              PointerMoved="DragSurface_OnPointerMoved"
              PointerReleased="DragSurface_OnPointerReleased"
              PointerCaptureLost="DragSurface_OnPointerCaptureLost">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock x:Name="DragGrip"
                     Grid.Column="0"
                     Margin="0,0,7,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="14"
                     Text="⠿" />
          <Ellipse Grid.Column="1"
                   Width="7"
                   Height="7"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Fill="{Binding StatusColor, Converter={StaticResource StatusColorToBrushConverter}}" />
          <StackPanel Grid.Column="2"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Binding WorkingDirectory}">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       Text="{Binding WorkingDirectory}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="3"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <Border Margin="6,0,5,0"
                    Padding="7,3"
                    Background="#EAF0ED"
                    CornerRadius="8">
              <TextBlock x:Name="StatusLabel"
                         Foreground="{Binding StatusColor, Converter={StaticResource StatusColorToBrushConverter}}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Text="{Binding StatusText}" />
            </Border>
            <Button Classes="icon"
                    Command="{Binding StopCommand}"
                    Content="■"
                    IsVisible="{Binding IsRunning}"
                    ToolTip.Tip="停止当前回合" />
            <Button Classes="icon"
                    Command="{Binding ToggleMinimizeCommand}"
                    Content="{Binding MinimizeGlyph}"
                    ToolTip.Tip="最小化此对话" />
            <Button Classes="icon"
                    Command="{Binding CloseCommand}"
                    Content="×"
                    ToolTip.Tip="从工作台关闭" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            RowDefinitions="Auto,Auto,*,Auto"
            IsVisible="{Binding !IsMinimized}">
        <Border Grid.Row="0"
                Margin="9,9,9,0"
                Padding="10,8"
                Background="#FFF4E6"
                BorderBrush="#F1D4A9"
                BorderThickness="1"
                CornerRadius="7"
                IsVisible="{Binding HasPendingApproval}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Foreground="#8A571D"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="Codex 需要你的确认" />
              <TextBlock Margin="0,3,10,0"
                         Foreground="#9A682F"
                         FontSize="10"
                         Text="{Binding PendingApproval.Description}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
              <Button Classes="toolbar"
                      Command="{Binding DeclineCommand}"
                      Content="拒绝" />
              <Button Classes="primary"
                      Command="{Binding ApproveCommand}"
                      Content="允许本次" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="9,7,9,0"
                Padding="9,6"
                Background="#FDEDED"
                BorderBrush="#EFCACA"
                BorderThickness="1"
                CornerRadius="7"
                IsVisible="{Binding HasError}">
          <TextBlock Foreground="#A23D3D"
                     FontSize="10"
                     Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap" />
        </Border>

        <ScrollViewer x:Name="MessagesScroller"
                      Grid.Row="2"
                      Margin="8,7,8,4"
                      Padding="2"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="MessagesList"
                        ItemsSource="{Binding Messages}">
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,5">
                  <Border x:Name="UserMessageBubble"
                          MaxWidth="560"
                          Padding="10,7"
                          HorizontalAlignment="Right"
                          Background="#E1F2EA"
                          CornerRadius="8"
                          IsVisible="{Binding Role, Converter={StaticResource ChatRoleVisibilityConverter}, ConverterParameter=User}">
                    <TextBlock FontSize="12"
                               LineHeight="18"
                               Text="{Binding Text}"
                               TextWrapping="Wrap" />
                  </Border>

                  <StackPanel x:Name="AssistantMessageBody"
                              Margin="5,3,10,6"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding Role, Converter={StaticResource ChatRoleVisibilityConverter}, ConverterParameter=Assistant}">
                    <TextBlock x:Name="CodexRoleLabel"
                               Margin="0,0,0,4"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="Codex" />
                    <TextBlock FontSize="12"
                               LineHeight="19"
                               Text="{Binding Text}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="8"
                Background="#F4F6F7"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="MessageInput"
                     Classes="input"
                     MinHeight="38"
                     MaxHeight="92"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="True"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     KeyDown="MessageInput_OnKeyDown"
                     ToolTip.Tip="Enter 发送，Shift+Enter 换行" />
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Classes="primary"
                    Width="38"
                    Height="38"
                    Margin="7,0,0,0"
                    Padding="0"
                    Command="{Binding SendCommand}"
                    Content="↑"
                    FontSize="16"
                    ToolTip.Tip="发送" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="10"
              Padding="11,8"
              VerticalAlignment="Top"
              Background="#F4F6F7"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="7"
              IsVisible="{Binding IsMinimized}">
        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="11"
                   Text="此对话已最小化；点击标题栏的 □ 恢复。" />
      </Border>
    </Grid>
  </Border>
</UserControl>
