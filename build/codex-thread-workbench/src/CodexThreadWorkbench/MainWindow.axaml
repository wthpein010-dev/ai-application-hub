<Window x:Class="CodexThreadWorkbench.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:views="using:CodexThreadWorkbench.Views"
        Title="Codex 多线程工作台"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackgroundBrush}">
  <Grid RowDefinitions="64,Auto,*">
    <Border Grid.Row="0"
            Padding="18,0"
            Background="#F7F9FA"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Border Width="34"
                  Height="34"
                  Background="{StaticResource PrimaryBrush}"
                  CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       Text="C" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="Codex 多线程" />
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6"
                       Height="6"
                       Margin="0,1,6,0"
                       VerticalAlignment="Center"
                       Fill="{StaticResource PrimaryBrush}" />
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         Text="{Binding ConnectionText}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Margin="24,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="12"
                   Text="每张卡片都能直接继续对话 · Enter 发送 · Shift+Enter 换行"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button x:Name="CollapseButton"
                  Classes="toolbar"
                  Click="CollapseButton_OnClick"
                  Content="收起"
                  IsVisible="False" />
          <Button Classes="toolbar"
                  Command="{Binding ToggleFullScreenCommand}"
                  Content="{Binding WindowModeText}" />
          <Button Classes="toolbar"
                  Command="{Binding RefreshCommand}"
                  Content="刷新" />
          <Button x:Name="OpenThreadButton"
                  Classes="primary"
                  Command="{Binding OpenPickerCommand}"
                  Content="＋ 打开任务" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="14,12,14,0"
            Padding="12,9"
            Background="#FFF4E6"
            BorderBrush="#F1D4A9"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding HasGlobalError}">
      <TextBlock Foreground="#9A5B18"
                 FontSize="12"
                 Text="{Binding GlobalError}"
                 TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" Margin="7">
      <ItemsControl x:Name="ThreadGrid"
                    ItemsSource="{Binding OpenThreads}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <primitives:UniformGrid Rows="{Binding GridRows}"
                                    Columns="{Binding GridColumns}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:ThreadCardView ReorderRequested="ThreadCard_OnReorderRequested" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="#66EEF1F3"
              IsVisible="{Binding IsConnecting}">
        <Border Width="280"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
          <StackPanel>
            <ProgressBar Height="4"
                         IsIndeterminate="True"
                         Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Margin="0,15,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="正在读取 Codex 任务…" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <views:ThreadPickerOverlay x:Name="PickerOverlay"
                               Grid.RowSpan="3"
                               IsVisible="{Binding IsPickerOpen}" />
  </Grid>
</Window>
