<Window x:Class="CodexThreadWorkbench.ConfirmationOverlayWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 待确认"
        Width="360"
        Height="560"
        MinHeight="0"
        MaxHeight="720"
        SizeToContent="Manual"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="Button.overlayPrimary">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#238B67" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#238B67" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.overlayPrimary:pointerover">
      <Setter Property="Background" Value="#187655" />
    </Style>
    <Style Selector="Button.overlayQuiet">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#F4F8F6" />
      <Setter Property="Foreground" Value="#52615C" />
      <Setter Property="BorderBrush" Value="#CFE2DA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.overlayQuiet:pointerover">
      <Setter Property="Background" Value="#F0FAF6" />
      <Setter Property="BorderBrush" Value="#9CCDBA" />
    </Style>
  </Window.Styles>

  <Grid x:Name="OverlayRoot"
        Background="Transparent"
        PointerEntered="OverlayRoot_OnPointerEntered"
        PointerExited="OverlayRoot_OnPointerExited">
  <Border x:Name="OverlaySurface"
          Margin="0,14,14,0"
          Padding="16,18,16,16"
          BorderBrush="#D5E5DD"
          BorderThickness="1"
          BoxShadow="0 8 24 0 #29233F35"
          CornerRadius="22">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FCFEFC" Offset="0" />
        <GradientStop Color="#F3F8F5" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <Grid Grid.Column="0"
              Width="44"
              Height="50"
              Margin="0,0,10,0">
          <Border x:Name="TaskSpriteAura"
                  Width="52"
                  Height="52"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#68B7F1D7"
                  CornerRadius="26"
                  IsHitTestVisible="False"
                  Opacity="0" />

          <Path x:Name="TaskSparkRight"
                Width="9"
                Height="9"
                Margin="0,-2,1,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M 4.5,0 L 5.7,3.2 L 9,4.5 L 5.7,5.7 L 4.5,9 L 3.2,5.7 L 0,4.5 L 3.2,3.2 Z"
                Fill="#F19A68"
                IsHitTestVisible="False"
                Opacity="0" />
          <Path x:Name="TaskSparkLeft"
                Width="7"
                Height="7"
                Margin="1,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Data="M 3.5,0 L 4.4,2.6 L 7,3.5 L 4.4,4.4 L 3.5,7 L 2.6,4.4 L 0,3.5 L 2.6,2.6 Z"
                Fill="#F4C15D"
                IsHitTestVisible="False"
                Opacity="0" />

          <Border x:Name="TaskSprite"
                  Width="42"
                  Height="42"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BorderBrush="#FFFFFF"
                  BorderThickness="2"
                  BoxShadow="0 6 16 0 #3D1D7458"
                  CornerRadius="15"
                  RenderTransformOrigin="50%,50%">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#3DC894" Offset="0" />
                <GradientStop Color="#1E8C67" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Path Margin="0,-4,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Data="M 0,5 L 4,1 L 8,5"
                    Stroke="#E8FFF6"
                    StrokeThickness="1.5" />
              <Ellipse Width="4"
                       Height="4"
                       Margin="0,-10,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Fill="#FFE19B" />
              <Border Width="29"
                      Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="#F8FFFC"
                      CornerRadius="9">
                <Canvas Width="29" Height="24">
                  <Ellipse Width="4" Height="5" Canvas.Left="7" Canvas.Top="7" Fill="#245F4C" />
                  <Ellipse Width="4" Height="5" Canvas.Left="18" Canvas.Top="7" Fill="#245F4C" />
                  <Path Data="M 8,15 C 11,19 18,19 21,15"
                        Stroke="#2A8D69"
                        StrokeThickness="1.6" />
                </Canvas>
              </Border>
              <Border Width="15"
                      Height="15"
                      Margin="0,0,-3,-3"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Background="#F08B62"
                      BorderBrush="#FFFFFF"
                      BorderThickness="1.5"
                      CornerRadius="8">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="✓" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <StackPanel x:Name="DragHandle"
                    Grid.Column="1"
                    Background="Transparent"
                    Cursor="SizeAll"
                    VerticalAlignment="Center"
                    PointerPressed="DragHandle_OnPointerPressed"
                    ToolTip.Tip="拖动以移动待确认窗口">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#243F33" Text="待确认" />
            <Border Background="#E3F3EB" CornerRadius="7" Padding="6,1"
                    VerticalAlignment="Center" IsVisible="{Binding HasItems}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#237253" Text="{Binding BadgeText}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#86988F" LetterSpacing="1.4" Text="CODEX" />
        </StackPanel>

        <ToggleSwitch x:Name="AutoConfirmToggle"
                      Grid.Column="2"
                      Margin="4,0,0,0"
                      MinWidth="0"
                      FontSize="11"
                      VerticalAlignment="Center"
                      OffContent="自动"
                      OnContent="自动"
                      IsChecked="{Binding IsAutoConfirmEnabled, Mode=OneWay}"
                      IsEnabled="{Binding CanToggleAutoConfirm}"
                      Click="AutoConfirmToggle_OnClick"
                      PointerExited="ActionButton_OnPointerExited"
                      ToolTip.Tip="开启后，新出现的待确认任务会自动执行确认继续" />

      </Grid>

      <StackPanel Grid.Row="1">
        <Border Margin="0,10,0,0"
                Padding="11,8"
                Background="#FFF5E8"
                BorderBrush="#F2D3A9"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding HasMonitorError}">
          <TextBlock Foreground="#9A5B18"
                     FontSize="11"
                     Text="{Binding MonitorErrorText}"
                     LineHeight="17" MaxLines="3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding MonitorErrorText}"
                     TextWrapping="Wrap" />
        </Border>

        <Border Margin="0,10,0,0"
                Padding="11,8"
                Background="#FFF5E8"
                BorderBrush="#F2D3A9"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding HasAutoConfirmError}">
          <TextBlock Foreground="#9A5B18"
                     FontSize="11"
                     Text="{Binding AutoConfirmErrorText}"
                     LineHeight="17" MaxLines="3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding AutoConfirmErrorText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="TaskScroll" Grid.Row="2"
                    Margin="0,18,0,0"
                    IsVisible="{Binding HasItems}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ConfirmationList"
                      ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10"
                      Padding="13,14"
                      Background="#FFFFFF"
                      BorderBrush="#DCE8E1"
                      BorderThickness="1"
                      CornerRadius="15">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <Ellipse Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Fill="#F08B62" />
                    <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Margin="0,8,0,13"
                             Foreground="#61736C"
                             FontSize="12"
                             LineHeight="18"
                             MaxLines="3"
                             Text="{Binding RequestPreview}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2"
                             Margin="0,0,0,10"
                             VerticalAlignment="Center"
                             Foreground="#A75B3B"
                             FontSize="11"
                             IsVisible="{Binding HasError}"
                             Text="{Binding ErrorText}"
                             TextWrapping="Wrap" MaxLines="3"
                             TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="3" ColumnDefinitions="*,*,1.4*">
                  <Button Grid.Column="0" Margin="0,0,6,0"
                          Classes="overlayQuiet"
                          Click="ViewButton_OnClick"
                          Content="查看"
                          IsEnabled="{Binding IsActionEnabled}"
                          PointerExited="ActionButton_OnPointerExited"
                          ToolTip.Tip="在 Codex 中查看此任务" />
                  <Button Grid.Column="1" Margin="0,0,6,0"
                          Classes="overlayQuiet"
                          Click="IgnoreButton_OnClick"
                          Content="忽略"
                          IsEnabled="{Binding IsActionEnabled}"
                          PointerExited="ActionButton_OnPointerExited" />
                  <Button Grid.Column="2"
                          Classes="overlayPrimary"
                          Click="ConfirmButton_OnClick"
                          Content="{Binding ActionText}"
                          IsEnabled="{Binding IsActionEnabled}"
                          PointerExited="ActionButton_OnPointerExited" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center"
                  HorizontalAlignment="Center" Spacing="18" IsVisible="{Binding !RequiresAttention}">
        <Grid Width="104" Height="104">
          <Ellipse Width="102" Height="102" Stroke="#E0EBE4" StrokeThickness="1" />
          <Ellipse Width="78" Height="78" Fill="#EAF3ED" />
          <Border Width="46" Height="46" Background="#FFFFFF" CornerRadius="16"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  BoxShadow="0 5 14 0 #172A694E">
            <Path Width="21" Height="16" Data="M 1,8 L 8,15 L 20,1"
                  Stroke="#419575" StrokeThickness="2.5" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Ellipse Width="7" Height="7" Margin="0,6,12,0" Fill="#D5B988"
                   HorizontalAlignment="Right" VerticalAlignment="Top" />
          <Ellipse Width="5" Height="5" Margin="9,0,0,14" Fill="#93C5AF"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Text="暂无待确认" FontSize="13" Foreground="#83958A" HorizontalAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,12,0,0"
              BorderBrush="#DCE8E1" BorderThickness="0,1,0,0">
        <Grid>
          <Button x:Name="ConfirmAllButton" Height="42"
                  HorizontalAlignment="Stretch" Classes="overlayPrimary"
                  Click="ConfirmAllButton_OnClick" Content="{Binding ConfirmAllText}"
                  IsEnabled="{Binding CanConfirmAll}" IsVisible="{Binding HasItems}"
                  PointerExited="ActionButton_OnPointerExited" />
          <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="#86988F"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Height="25"
                     IsVisible="{Binding !HasItems}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

    </Grid>
  </Border>
  <Border x:Name="AttentionBadge"
          Width="28"
          Height="28"
          Margin="0,0,0,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Background="#F08B62"
          BorderBrush="#FFF9F3"
          BorderThickness="2"
          BoxShadow="0 5 15 0 #4A9B4D32"
          CornerRadius="14"
          IsHitTestVisible="False"
          IsVisible="{Binding HasItems}"
          RenderTransformOrigin="50%,50%">
    <Canvas Width="16" Height="16">
      <Path Width="12"
            Height="12"
            Canvas.Left="2"
            Canvas.Top="1"
            Data="M 2,9 L 3.2,7.5 L 3.2,5.3 C 3.2,2.8 4.5,1.4 6,1.4 C 7.5,1.4 8.8,2.8 8.8,5.3 L 8.8,7.5 L 10,9 Z"
            Fill="#FFF9F3"
            Stretch="Fill" />
      <Ellipse Width="4"
               Height="2.5"
               Canvas.Left="6"
               Canvas.Top="12"
               Fill="#FFF9F3" />
      <Ellipse Width="3"
               Height="3"
               Canvas.Left="11.5"
               Canvas.Top="1"
               Fill="#FFE49B" />
    </Canvas>
  </Border>
  <Border x:Name="IdleSideTab"
          Width="16"
          Height="64"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Background="#238B67"
          BorderBrush="#D9F4E8"
          BorderThickness="0,1,1,1"
          CornerRadius="0,8,8,0"
          IsVisible="False"
          ToolTip.Tip="停留片刻可展开">
    <Path Width="5" Height="14"
          Data="M 0,0 L 5,7 L 0,14"
          Stroke="#F2FFF8" StrokeThickness="1.5"
          HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>
  </Grid>
</Window>
