<Window x:Class="CodexThreadWorkbench.ConfirmationOverlayWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 待确认"
        Width="560"
        MinHeight="0"
        MaxHeight="720"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="Button.overlayPrimary">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Background" Value="#238B67" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#238B67" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlayPrimary:pointerover">
      <Setter Property="Background" Value="#187655" />
    </Style>
    <Style Selector="Button.overlayQuiet">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#52615C" />
      <Setter Property="BorderBrush" Value="#CFE2DA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlayQuiet:pointerover">
      <Setter Property="Background" Value="#F0FAF6" />
      <Setter Property="BorderBrush" Value="#9CCDBA" />
    </Style>
  </Window.Styles>

  <Border x:Name="OverlaySurface"
          Padding="18,16,18,9"
          BorderBrush="#BBDDD0"
          BorderThickness="1"
          BoxShadow="0 14 42 0 #45233F35"
          CornerRadius="19"
          PointerEntered="OverlaySurface_OnPointerEntered"
          PointerExited="OverlaySurface_OnPointerExited">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FFFCF7" Offset="0" />
        <GradientStop Color="#F6FFF9" Offset="0.52" />
        <GradientStop Color="#EDF9F5" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
        <Grid Grid.Column="0"
              Width="56"
              Height="50"
              Margin="0,0,11,0">
          <Border x:Name="TaskSpriteAura"
                  Width="52"
                  Height="52"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#68B7F1D7"
                  CornerRadius="26"
                  IsHitTestVisible="False"
                  Opacity="0" />

          <Path x:Name="TaskSparkRight"
                Width="9"
                Height="9"
                Margin="0,-2,1,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M 4.5,0 L 5.7,3.2 L 9,4.5 L 5.7,5.7 L 4.5,9 L 3.2,5.7 L 0,4.5 L 3.2,3.2 Z"
                Fill="#F19A68"
                IsHitTestVisible="False"
                Opacity="0" />
          <Path x:Name="TaskSparkLeft"
                Width="7"
                Height="7"
                Margin="1,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Data="M 3.5,0 L 4.4,2.6 L 7,3.5 L 4.4,4.4 L 3.5,7 L 2.6,4.4 L 0,3.5 L 2.6,2.6 Z"
                Fill="#F4C15D"
                IsHitTestVisible="False"
                Opacity="0" />

          <Border x:Name="TaskSprite"
                  Width="42"
                  Height="42"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BorderBrush="#FFFFFF"
                  BorderThickness="2"
                  BoxShadow="0 6 16 0 #3D1D7458"
                  CornerRadius="15"
                  RenderTransformOrigin="50%,50%">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#3DC894" Offset="0" />
                <GradientStop Color="#1E8C67" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Path Margin="0,-4,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Data="M 0,5 L 4,1 L 8,5"
                    Stroke="#E8FFF6"
                    StrokeThickness="1.5" />
              <Ellipse Width="4"
                       Height="4"
                       Margin="0,-10,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Fill="#FFE19B" />
              <Border Width="29"
                      Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="#F8FFFC"
                      CornerRadius="9">
                <Canvas Width="29" Height="24">
                  <Ellipse Width="4" Height="5" Canvas.Left="7" Canvas.Top="7" Fill="#245F4C" />
                  <Ellipse Width="4" Height="5" Canvas.Left="18" Canvas.Top="7" Fill="#245F4C" />
                  <Path Data="M 8,15 C 11,19 18,19 21,15"
                        Stroke="#2A8D69"
                        StrokeThickness="1.6" />
                </Canvas>
              </Border>
              <Border Width="15"
                      Height="15"
                      Margin="0,0,-3,-3"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Background="#F08B62"
                      BorderBrush="#FFFFFF"
                      BorderThickness="1.5"
                      CornerRadius="8">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="✓" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <StackPanel x:Name="DragHandle"
                    Grid.Column="1"
                    Background="Transparent"
                    Cursor="SizeAll"
                    VerticalAlignment="Center"
                    PointerPressed="DragHandle_OnPointerPressed"
                    Spacing="2"
                    ToolTip.Tip="拖动以移动待确认窗口">
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Text="{Binding CountText}" />
          <TextBlock Foreground="#6C7E77"
                     FontSize="10.5"
                     Text="有任务等你决定时，我会来提醒你" />
        </StackPanel>

        <ToggleSwitch x:Name="AutoConfirmToggle"
                      Grid.Column="2"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      OffContent="自动确认已关闭"
                      OnContent="自动确认已开启"
                      IsChecked="{Binding IsAutoConfirmEnabled, Mode=OneWay}"
                      IsEnabled="{Binding CanToggleAutoConfirm}"
                      Click="AutoConfirmToggle_OnClick"
                      PointerExited="ActionButton_OnPointerExited"
                      ToolTip.Tip="开启后，新出现的待确认任务会自动执行确认继续" />

        <Button x:Name="ConfirmAllButton"
                Grid.Column="3"
                Classes="overlayPrimary"
                Click="ConfirmAllButton_OnClick"
                Content="{Binding ConfirmAllText}"
                IsEnabled="{Binding CanConfirmAll}"
                IsVisible="{Binding HasItems}"
                PointerExited="ActionButton_OnPointerExited" />
      </Grid>

      <Border x:Name="NewTaskBanner"
              Grid.Row="1"
              Margin="0,12,0,0"
              Padding="11,8"
              Background="#FFF1E8"
              BorderBrush="#FFD1BB"
              BorderThickness="1"
              CornerRadius="10"
              IsVisible="{Binding HasItems}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="8"
                  Height="8"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Background="#F08B62"
                  CornerRadius="4" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#8D4B31"
                     FontSize="11.5"
                     FontWeight="SemiBold"
                     Text="叮！有新任务等你决定" />
          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     Foreground="#B66D4E"
                     FontSize="10.5"
                     Text="确认后立即继续" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="2">
        <Border Margin="0,10,0,0"
                Padding="11,8"
                Background="#FFF5E8"
                BorderBrush="#F2D3A9"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding HasMonitorError}">
          <TextBlock Foreground="#9A5B18"
                     FontSize="11"
                     Text="{Binding MonitorErrorText}"
                     TextWrapping="Wrap" />
        </Border>

        <Border Margin="0,10,0,0"
                Padding="11,8"
                Background="#FFF5E8"
                BorderBrush="#F2D3A9"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding HasAutoConfirmError}">
          <TextBlock Foreground="#9A5B18"
                     FontSize="11"
                     Text="{Binding AutoConfirmErrorText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="3"
                    MaxHeight="540"
                    Margin="0,10,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ConfirmationList"
                      ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,9"
                      Padding="13"
                      Background="#FBFFFD"
                      BorderBrush="#CDE5DB"
                      BorderThickness="1"
                      BoxShadow="0 5 16 0 #1F2B6A55"
                      CornerRadius="13">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Row="0"
                              Grid.ColumnSpan="3"
                              Orientation="Horizontal"
                              Spacing="7">
                    <Border Padding="7,3"
                            Background="#E5F7EF"
                            CornerRadius="7">
                      <TextBlock Foreground="#23795A"
                                 FontSize="9.5"
                                 FontWeight="SemiBold"
                                 Text="待你决定" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Margin="0,7,0,11"
                             Foreground="#61736C"
                             FontSize="11"
                             LineHeight="17"
                             MaxLines="2"
                             Text="{Binding RequestPreview}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Foreground="#A75B3B"
                             FontSize="11"
                             IsVisible="{Binding HasError}"
                             Text="{Binding ErrorText}"
                             TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="2"
                          Grid.Column="1"
                          Classes="overlayQuiet"
                          Click="IgnoreButton_OnClick"
                          Content="忽略"
                          IsEnabled="{Binding IsActionEnabled}"
                          PointerExited="ActionButton_OnPointerExited" />
                  <Button Grid.Row="2"
                          Grid.Column="2"
                          Classes="overlayPrimary"
                          Click="ConfirmButton_OnClick"
                          Content="{Binding ActionText}"
                          IsEnabled="{Binding IsActionEnabled}"
                          PointerExited="ActionButton_OnPointerExited" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border x:Name="IdleGrabber"
              Grid.Row="4"
              Width="148"
              Height="4"
              Margin="0,9,0,0"
              HorizontalAlignment="Center"
              Background="#3DB88A"
              CornerRadius="2"
              IsVisible="{Binding !HasItems}"
              Opacity="0.78"
              ToolTip.Tip="鼠标移入可查看扫描状态" />
    </Grid>
  </Border>
</Window>
