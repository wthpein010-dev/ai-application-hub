{
  "name": "pureshrink-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "PureShrink local-first lossless media compressor for Windows and macOS",
  "author": "wthpein010-dev",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron",
    "test": "node --test ../../tests/pureshrink-core.test.mjs ../../tests/pureshrink-browser-engine.test.mjs ../../tests/pureshrink-desktop.test.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac:x64": "electron-builder --mac zip --x64",
    "dist:mac:arm64": "electron-builder --mac zip --arm64",
    "verify:win": "node scripts/verify-package.mjs dist windows",
    "verify:mac": "node scripts/verify-package.mjs dist macos"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.wthpein010.pureshrink",
    "productName": "PureShrink",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/fflate/**/*",
      "native/archive-worker.cjs"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "native/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../projects/pureshrink",
        "to": "app/projects/pureshrink",
        "filter": [
          "**/*",
          "!assets/brand-master.png",
          "!assets/pureshrink-icon.ico",
          "!assets/pureshrink-icon.icns"
        ]
      },
      {
        "from": "../../assets",
        "to": "app/assets",
        "filter": [
          "subpage-shell.css",
          "hub-video-player.css",
          "hub-video-player.js"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "../../projects/pureshrink/assets/pureshrink-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PureShrink-Windows-x64.${ext}"
    },
    "mac": {
      "icon": "../../projects/pureshrink/assets/pureshrink-icon.icns",
      "target": [
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PureShrink-macOS-${arch}.${ext}"
    }
  }
}
