{
  "name": "codex-ai-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:hub": "node scripts/hub-publication-audit.mjs",
    "playwright:install": "playwright install chromium",
    "build:simuai-video": "node scripts/build-simuai-tutorial.mjs",
    "start:simuai": "node projects/simuai/server.mjs",
    "test:simuai": "node --test tests/simuai-engine.test.mjs tests/simuai-template.test.mjs tests/simuai-presenter.test.mjs tests/simuai-compiler.test.mjs tests/simuai-page.test.mjs tests/simuai-chart.test.mjs",
    "test:simuai-browser": "node tests/simuai-browser-smoke.mjs",
    "test:simuai-publish": "node --test tests/simuai-publish.test.mjs",
    "test:paws-browser": "node --test tests/paws-level-editor-static-server.test.mjs && node tests/paws-level-editor-browser-smoke.mjs",
    "verify:paws-ai-corpus": "node scripts/verify-paws-ai-corpus.mjs"
